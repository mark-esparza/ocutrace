    given-names: Mark
    orcid: "https://orcid.org/0009-0000-5171-102X"
repository-code: "https://github.com/mark-esparza/ocutrace"
url: "https://mark-esparza.github.io/ocutrace/"
license: MIT
version: 0.1.0
keywords:
  - eye tracking
  - nystagmus
  - saccades
  - oculomotor
  - video oculography
